---
// Slide 5 of the Flying DNA presentation, rebuilt as an accessible loop.
// Coordinates follow the slide layout in a 1000 × 440 canvas; the animated
// GIFs and the embedded video play as silent, looping native video players.
import deck from "../data/deck.json";
import media from "../../public/media/evtol-clips.json";
import { asset } from "../data/paths";

const X0 = -20, Y0 = 100, W = 1000, H = 440;
const box = (x: number, y: number, w: number, h: number) =>
  `--x:${(((x - X0) / W) * 100).toFixed(3)}%;--y:${(((y - Y0) / H) * 100).toFixed(3)}%;--w:${((w / W) * 100).toFixed(3)}%;--h:${((h / H) * 100).toFixed(3)}%`;
const clip = (id: string) => media.clips.find((item) => item.id === id)!;
const figure = (id: string) => deck.figures.find((item) => item.id === id)!;

type Node = {
  key: string;
  label: string[];
  place: [number, number, number, number];
  labelAt: "above" | "below" | "inside";
  video?: string;
  image?: { file: string; width: number; height: number; alt: string };
};
const nodes: Node[] = [
  { key: "sensor", label: ["Wind Sensor"], place: [70, 192, 64, 80], labelAt: "above",
    image: { file: "figures/presentation/wind-sensor.webp", width: 240, height: 300, alt: "A compact cylindrical wind sensor on a short mounting post." } },
  { key: "drone", label: ["Drone"], place: [0, 285, 190, 107], labelAt: "below", video: "problem-real-flight" },
  { key: "network", label: ["Drone Sensing Network"], place: [222, 153, 228, 137], labelAt: "above", video: "drone-sensing-network" },
  { key: "sensing", label: ["Wind Sensing"], place: [500, 153, 160, 159], labelAt: "above",
    image: { file: "figures/presentation/wind-sensing.webp", width: 600, height: 596, alt: "Icon of a sensor displaying a waveform, with colored lines fanning out to the right." } },
  { key: "city", label: ["City Model Registration"], place: [730, 153, 200, 135], labelAt: "above",
    image: figure("city") },
  { key: "cfd", label: ["CFD /", "Physics-Informed AI"], place: [700, 293, 210, 58], labelAt: "inside" },
  { key: "field", label: ["Urban Wind Field"], place: [730, 354, 210, 138], labelAt: "below",
    image: figure("cfd") },
  { key: "prediction", label: ["Wind Prediction"], place: [490, 382, 196, 110], labelAt: "below", video: "wind-prediction" },
  { key: "impact", label: ["Wind Impact on Drone"], place: [222, 364, 228, 128], labelAt: "below", video: "problem-wind-simulation" },
];
// Arrows: [x1, y1, x2, y2], drawn from the diamond end to the arrowhead.
const arrows = [
  [192, 298, 218, 270], // drone → sensing network
  [454, 225, 496, 225], // sensing network → wind sensing
  [664, 225, 726, 225], // wind sensing → city model
  [918, 292, 918, 350], // city model → urban wind field
  [726, 437, 690, 437], // urban wind field → wind prediction
  [486, 437, 454, 437], // wind prediction → wind impact
  [218, 382, 194, 362], // wind impact → drone
];
---
<figure class="wind-loop wide-media" aria-label="Urban wind field loop" aria-describedby="wind-loop-summary">
  <p id="wind-loop-summary" class="sr-only">Urban wind field loop, from the Flying DNA presentation. A drone carrying a wind sensor flies a drone sensing network through the city. Wind sensing is registered to a 3D city model. CFD and physics-informed AI produce an urban wind field. The field supports wind prediction, and the predicted wind impact on the drone leads back to the drone. Four panels are silent looping videos with native controls; the others are still images.</p>
  <div class="wind-loop-canvas">
    <svg class="wind-loop-arrows" viewBox={`${X0} ${Y0} ${W} ${H}`} aria-hidden="true" focusable="false">
      <defs>
        <marker id="wind-loop-head" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="4" markerHeight="4" orient="auto"><path d="M0 0 10 5 0 10z" /></marker>
        <marker id="wind-loop-tail" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="3" markerHeight="3" orient="auto"><path d="M5 0 10 5 5 10 0 5z" /></marker>
      </defs>
      {arrows.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} marker-start="url(#wind-loop-tail)" marker-end="url(#wind-loop-head)" />)}
    </svg>
    <ol class="wind-loop-steps">
      {nodes.map((node) => {
        const c = node.video ? clip(node.video) : undefined;
        const vid = `wind-loop-${node.key}-video`;
        return <li class:list={["wind-loop-step", `wind-loop-${node.key}`, `label-${node.labelAt}`, { "text-step": !node.video && !node.image }]} style={box(...node.place)}>
          <p class="wind-loop-label">{node.label.map((line, i) => <>{i > 0 && <br />}{line}</>)}</p>
          {c && <div class="wind-loop-media">
            <video id={vid} data-playback-group="research" data-duration={c.duration} controls controlslist="nodownload" muted loop playsinline preload="none" width={c.width} height={c.height} poster={asset(`media/${c.poster}`)} aria-label={c.title} aria-describedby={`${vid}-description`}>
              <source src={asset(`media/${c.file}`)} type="video/mp4" />
              <track kind="descriptions" src={asset(`media/${c.track}`)} srclang="en" label="English visual descriptions" />
              Your browser does not support video playback. A text description follows.
            </video>
            <div id={`${vid}-description`} class="sr-only"><p>{c.description}</p><p>{c.scope}</p></div>
          </div>}
          {node.image && <div class="wind-loop-media"><img src={asset(node.image.file)} width={node.image.width} height={node.image.height} alt={node.image.alt} loading="lazy" decoding="async" /></div>}
        </li>;
      })}
    </ol>
    <p class="wind-loop-return" aria-hidden="true">↻ Back to the drone</p>
  </div>
</figure>
